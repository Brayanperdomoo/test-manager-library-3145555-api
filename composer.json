{
  "name": "manager-library/api",
  "type": "project",
  "description": "Laravel JSON API for Manager Library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^6.11",
    "laravel/framework": "^13.0"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": [ "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi" ],
    "check": "@php artisan about --only=environment"
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": { "php-http/discovery": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
